{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "esnext"
    ],
    "moduleDetection": "force",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@dtsx/dtsx": [
        "./packages/dtsx/src/index.ts"
      ],
      "@dtsx/dtsx/generator": [
        "./packages/dtsx/src/generator.ts"
      ],
      "@dtsx/dtsx/cache": [
        "./packages/dtsx/src/cache.ts"
      ],
      "@dtsx/bun": [
        "./packages/bun-plugin/src/index.ts"
      ],
      "@dtsx/dtsx/tsdown": [
        "./packages/dtsx/src/plugins/tsdown.ts"
      ],
      "@dtsx/vite": [
        "./packages/vite-plugin/src/index.ts"
      ],
      "@dtsx/tsdown": [
        "./packages/tsdown-plugin/src/index.ts"
      ]
    },
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "noEmit": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedDeclarations": true,
    "verbatimModuleSyntax": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/*/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/node_modules/**",
    "dist",
    "**/dist",
    "**/dist/**",
    "**/*.d.ts",
    "**/build/**",
    "**/coverage/**",
    "packages/dtsx/src/checker.ts",
    "packages/dtsx/src/extractor/builders.ts",
    "packages/dtsx/src/extractor/cache.ts",
    "packages/dtsx/src/extractor/declarations.ts",
    "packages/dtsx/src/extractor/helpers.ts",
    "packages/dtsx/src/extractor/index.ts"
  ]
}
