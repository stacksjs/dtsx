{
  "name": "vite-plugin-dtsx",
  "type": "module",
  "version": "0.11.23",
  "private": true,
  "description": "A modern, fast .d.ts generation tool, powered by Bun.",
  "author": "Chris Breuer <chris@stacksjs.org>",
  "license": "MIT",
  "homepage": "https://github.com/stacksjs/dtsx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/dtsx.git"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/dtsx/issues"
  },
  "keywords": [
    "dts",
    "generation",
    "isolated declarations",
    "development",
    "bun",
    "stacks",
    "typescript",
    "javascript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build.ts",
    "lint": "bunx --bun pickier run . --mode lint",
    "lint:fix": "bunx --bun pickier run . --mode lint --fix",
    "fresh": "bunx rimraf node_modules/ bun.lock && bun i",
    "changelog": "bunx changelogen --output CHANGELOG.md",
    "prepublishOnly": "bun --bun run build",
    "release": "bun run changelog && bunx bumpp package.json --all",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@stacksjs/dtsx": "workspace:*",
    "vite": "^7.3.1"
  },
  "peerDependencies": {
    "vite": "^4.0.0 || ^5.0.0"
  },
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bunx --bun pickier run . --mode lint --fix"
      }
    }
  }
}
